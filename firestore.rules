rules_version = '2';

// -----------------------------------------------------------------------
// Reglas de seguridad de Firestore para Ronda.
//
// Este es un proyecto MVP sin Cloud Functions: todos los contadores
// denormalizados (followerCount, followingCount, listingCount,
// activeListingCount, ratingAvg, ratingCount) se recalculan y escriben
// desde el propio cliente dueño del documento ("self-write only"). Esto es
// intencional para simplificar el scaffold, pero significa que un cliente
// malicioso podría, en el peor caso, dejar sus propios contadores
// desincronizados (nunca los de otro usuario). Para producción se
// recomienda mover el mantenimiento de contadores a Cloud Functions
// (Firestore triggers) para que sean 100% autoritativos.
// -----------------------------------------------------------------------

function isSignedIn() {
  return request.auth != null;
}

function isOwner(uid) {
  return isSignedIn() && request.auth.uid == uid;
}

function unchanged(field, resource, request) {
  return !(field in request.resource.data) ||
    (field in resource.data && request.resource.data[field] == resource.data[field]);
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // users/{uid}
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();

      allow create: if isOwner(uid)
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.displayName is string
        && request.resource.data.isPro == false
        && request.resource.data.followerCount == 0
        && request.resource.data.followingCount == 0
        && request.resource.data.listingCount == 0
        && request.resource.data.activeListingCount == 0
        && request.resource.data.ratingAvg == 0
        && request.resource.data.ratingCount == 0;

      // El propio usuario puede editar su perfil. isPro solo puede cambiarlo
      // un proceso de administración (consola / futura Cloud Function), no
      // el cliente, así que exigimos que se mantenga igual.
      allow update: if isOwner(uid) && unchanged('isPro', resource, request);

      allow delete: if false;

      // ------------------ following ------------------
      // uid sigue a following/{targetUid}. Solo el propio uid administra su
      // lista de "a quién sigo".
      match /following/{targetUid} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(uid) && targetUid != uid;
        allow update: if false;
      }

      // ------------------ followers ------------------
      // followers/{followerUid} representa que followerUid sigue a uid.
      // Solo followerUid puede crear/borrar su propio registro (nadie puede
      // agregar o quitar seguidores en nombre de otro usuario).
      match /followers/{followerUid} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == followerUid && followerUid != uid;
        allow update: if false;
      }

      // ------------------ interactions (historial de swipes) ------------------
      match /interactions/{listingId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      // ------------------ notifications ------------------
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(uid);
        // Cualquier usuario autenticado puede generar una notificación para
        // otro usuario (ej: "te empezó a seguir", "te calificó"), siempre
        // que llegue no leída y con la forma esperada.
        allow create: if isSignedIn()
          && request.resource.data.read == false
          && request.resource.data.type is string
          && request.resource.data.title is string
          && request.resource.data.body is string;
        // Solo el dueño puede marcarla como leída.
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    // ---------------------------------------------------------------
    // listings/{listingId}
    // ---------------------------------------------------------------
    match /listings/{listingId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.price is number && request.resource.data.price > 0
        && request.resource.data.photos is list
        && request.resource.data.photos.size() >= 1 && request.resource.data.photos.size() <= 5
        && request.resource.data.status in ['active', 'sold', 'archived']
        && request.resource.data.likeCount == 0;

      // El vendedor puede editar su propia publicación (título, fotos,
      // estado, etc). Cualquier usuario autenticado puede además sumar o
      // restar 1 al likeCount (efecto de un "me gusta" al deslizar), sin
      // tocar ningún otro campo.
      allow update: if isSignedIn() && (
        (
          resource.data.sellerId == request.auth.uid &&
          unchanged('sellerId', resource, request) &&
          request.resource.data.photos is list &&
          request.resource.data.photos.size() >= 1 && request.resource.data.photos.size() <= 5 &&
          request.resource.data.status in ['active', 'sold', 'archived']
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']) &&
          (request.resource.data.likeCount == resource.data.likeCount + 1 ||
            request.resource.data.likeCount == resource.data.likeCount - 1)
        )
      );

      allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // ratings/{ratingId}  (inmutables una vez creadas)
    // ---------------------------------------------------------------
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.raterId == request.auth.uid
        && request.resource.data.ratedUserId != request.auth.uid
        && request.resource.data.stars is number
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // pro_account_requests/{requestId}
    // Solo el propio usuario puede crear y leer sus solicitudes. La
    // aprobación/rechazo se hace manualmente desde la consola de Firebase
    // (o una futura Cloud Function con permisos de administrador), por lo
    // que no se permite update/delete desde el cliente.
    // ---------------------------------------------------------------
    match /pro_account_requests/{requestId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }
  }
}
