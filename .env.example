# Copia este archivo a ".env" y completa los valores con los datos de tu
# proyecto de Firebase (Configuración del proyecto > Tus apps > SDK de Firebase).
#
# Todas las variables deben empezar con EXPO_PUBLIC_ para que Expo las incluya
# en el bundle del cliente. Ninguna de estas claves es secreta: son la
# configuración pública del SDK web de Firebase.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcional: solo si usás Google Analytics para Firebase en web.
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# IDs de cliente OAuth de Google (Google Cloud Console > Credenciales).
# Necesitás un client ID por plataforma para expo-auth-session.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID se usa como fallback genérico (ej: Expo Go / web).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
